# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:ios)

XCODEPROJ = "WhatTheCoffee.xcodeproj"
SCHEME = "WhatTheCoffee"

platform :ios do
  before_all do
    # App Store Connect API 키가 있으면 2FA 없이 인증한다.
    # 없으면 Apple ID 대화형 로그인이 걸려 사람이 직접 실행해야 한다.
    key_path = ENV["ASC_KEY_PATH"]
    next if key_path.nil?

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(key_path))
  end

  desc "TestFlight에 새 빌드 올리기"
  lane :beta do
    build_release
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "앱스토어에 새 빌드 올리기 (심사 제출은 App Store Connect에서)"
  lane :release do
    build_release
    upload_to_app_store(
      # 메타데이터는 fastlane metadata 레인으로 따로 올린다.
      # 빌드를 올리는 시점에는 대상 버전이 아직 없을 수 있어 엉뚱한 버전에 덮어쓸 수 있다.
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false)
  end

  desc "릴리즈 노트와 프로모션 텍스트만 올리기 (빌드는 건드리지 않음)"
  lane :metadata do
    # 심사 중인 버전에 덮어쓰지 않도록, 올릴 버전이 App Store Connect에 만들어진 뒤에 실행한다.
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false)
  end

  private_lane :build_release do
    increment_build_number(xcodeproj: XCODEPROJ)
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      # 끄지 않으면 Xcode가 App Store Connect를 조회해 빌드 번호를 임의로 올린다.
      # 저장소 값과 실제 업로드 번호가 어긋나므로 여기서 막는다.
      export_options: { manageAppVersionAndBuildNumber: false })
  end
end
